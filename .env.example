# Normies CredHub — environment variable NAMES only. Never put real values in this file or in git.
# Set real values in Vercel (Project > Settings > Environment Variables) or a local, git-ignored .env.local.

# --- Supabase ---
SUPABASE_URL=
# Public (anon) key. RLS must protect every table it can reach.
SUPABASE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never NEXT_PUBLIC_. Required for floor/burn/workflow and recommendation_feedback tables.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (Upstash / Vercel KV). Missing in production = strict in-process limits. ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Cron. Vercel sends Authorization: Bearer <CRON_SECRET>. Required for /api/zulo/canvas-watch cron. ---
CRON_SECRET=

# --- Inference providers ---
VENICE_API_KEY=
VENICE_BASE_URL=
XAI_API_KEY=

# --- Data providers ---
OPENSEA_API_KEY=
RESERVOIR_API_KEY=
MORALIS_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
ETH_RPC_URL=
NEXT_PUBLIC_ETH_RPC_URL=
NORMIES_GACHA_API_BASE=
NORMIES_RAFFLE_API_BASE=
GACHA_RAFFLE_API_BASE=

# --- Site ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
CANVAS_WATCHLIST=

# --- Switches (see lib/burn-buy/switches.ts) ---
# live | pending | unset (contract decides)
PIXEL_MARKET=
# promo | normal | unset (clock decides)
BURN_YIELD_MODE=
JEV_DISABLE=

# --- Payments / currency scaffolding. NO CRYPTO AS INCOME: "live" is hard-blocked in code (lib/payments/rail-policy.ts). ---
# planned | scaffold
ZULO_PAYMENT_RAIL_STATUS=
ZULO_PAYMENT_RECEIVER=
ZULO_TBA_PROVIDER_STATUS=
PIXEL_CURRENCY_ENABLED=
PIXEL_CURRENCY_STATUS=
PIXEL_CONVERSION_MODE=
PIXEL_CONVERSION_ORACLE=
PIXEL_AP_ORACLE_RATE=
DEFAULT_CURRENCY=

# --- Security ---
AUDIT_LOG_HMAC_SECRET=
CIRCUIT_BREAKER_THRESHOLD=
CIRCUIT_BREAKER_UNPAUSE_KEYS=
ZULO_FORCE_LOCKDOWN=
