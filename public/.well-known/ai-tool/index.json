{
  "name": "Normies CredHub / Zulo plugin",
  "description": "Trust before engage. Pulse → Paths → Act. Not official Normies Lab.",
  "origin": "https://normiescredhub.vercel.app",
  "llms": "/llms.txt",
  "loop": [
    "pulse",
    "paths",
    "act"
  ],
  "note": "Call Paths after Pulse. Do not ask for keys, seeds, signatures.",
  "humanUi": [
    "/",
    "/ask",
    "/paths",
    "/burn",
    "/pixels",
    "/dashboard"
  ],
  "tools": [
    {
      "slug": "normies-cred-pulse",
      "name": "Normies Cred Pulse",
      "manifest": "/.well-known/ai-tool/normies-cred-pulse.json",
      "callPathsAfterPulse": true,
      "chainToolIds": {
        "ethereum": 53,
        "base": 531,
        "robinhood": 15
      },
      "paths": {
        "public": {
          "method": "GET",
          "path": "/api/agent/{tokenId}/pulse",
          "gated": false,
          "note": "No gate. Enough to condition Paths ranking when the caller cannot pass the holder gate."
        },
        "holder": {
          "method": "POST",
          "path": "/api/agent",
          "gated": true,
          "gate": "ERC-8257 Eth #53, Normie NFT holders",
          "endpoint": "https://normiescredhub.vercel.app/api/agent",
          "note": "Official registered endpoint. Do not change; on-chain manifest hash is bound to this URL."
        }
      }
    },
    {
      "slug": "normies-paths",
      "name": "Normies Paths",
      "manifest": "/.well-known/ai-tool/normies-paths.json",
      "callAfter": "normies-cred-pulse",
      "note": "Call Paths after Pulse. Public Pulse GET is enough to condition ranking when the caller cannot pass the gate.",
      "chainToolIds": {
        "ethereum": 215,
        "base": 530,
        "robinhood": 14
      },
      "paths": {
        "holder": {
          "method": "POST",
          "path": "/api/zulo/paths",
          "gated": true,
          "gate": "ERC-8257 Eth #215, Normie NFT holders",
          "endpoint": "https://normiescredhub.vercel.app/api/zulo/paths"
        }
      }
    },
    {
      "slug": "normies-pixel-check",
      "name": "Normies Pixel Check",
      "manifest": "/.well-known/ai-tool/normies-pixel-check.json",
      "note": "Open access, read-only. Standalone: no Pulse needed. ERC-8257 tools: Ethereum #245, Base #786, Robinhood #16.",
      "chainToolIds": {
        "ethereum": 245,
        "base": 786,
        "robinhood": 16
      },
      "paths": {
        "public": {
          "method": "GET",
          "path": "/api/ap-check?token={tokenId} | ?wallet= | ?listings=1 | ?approvals= | ?contract= | ?calc=pixels|eth&amount=",
          "gated": false
        },
        "agent": {
          "method": "POST",
          "path": "/api/ap-check",
          "gated": false,
          "endpoint": "https://normiescredhub.vercel.app/api/ap-check",
          "body": "JSON with exactly one question, e.g. {\"token\":7141}, {\"listings\":true}, {\"calc\":\"eth\",\"amount\":0.5}"
        }
      },
      "humanUi": "/pixels"
    }
  ]
}
